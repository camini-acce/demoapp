param(
    [Parameter(Mandatory = $true)]
    [string]$Name,
    [string]$Repo = '',
    [switch]$Private,
    [switch]$Public
)

$baseDir = Join-Path $env:USERPROFILE 'Downloads\Aplicativos';
New-Item -ItemType Directory -Force -Path $baseDir | Out-Null;

$appPath = Join-Path $baseDir $Name;
if (Test-Path $appPath) {
    throw "A pasta '$appPath' já existe. Escolha outro nome."
}

New-Item -ItemType Directory -Force -Path $appPath | Out-Null;
Set-Location $appPath;

# Git init
if (Get-Command git -ErrorAction SilentlyContinue) {
    git init -b main
    git config user.name "camini-acce"
    git config user.email "camini.acce@gmail.com"
}

# Node template
@'
{
  "name": "",
  "version": "1.0.0",
  "description": "App criado pelo padrão Downloads/Aplicativos",
  "main": "app/server.js",
  "scripts": {
    "start": "node app/server.js",
    "dev": "node app/server.js",
    "deploy": "powershell -ExecutionPolicy Bypass -File .\\deploy.ps1"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pm2": "^5.4.2"
  }
}
